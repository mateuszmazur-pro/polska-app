{
  "expo": {
    "name": "POLSKA – Moja Ojczyzna",
    "slug": "polska-moja-ojczyzna",
    "version": "0.1.0",
    "scheme": "polska",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0C1D36",
    "ios": {
      "bundleIdentifier": "pl.mojaojczyzna.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pl.mojaojczyzna.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "estaloca-studio",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3ee531cc-72a1-4622-a72f-66c37cc6f631"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3ee531cc-72a1-4622-a72f-66c37cc6f631"
    }
  }
}
