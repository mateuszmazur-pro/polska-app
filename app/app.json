{
  "expo": {
    "name": "POLSKA – Moja Ojczyzna",
    "slug": "polska-moja-ojczyzna",
    "version": "0.1.0",
    "scheme": "polska",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0C1D36",
    "ios": {
      "bundleIdentifier": "pl.mojaojczyzna.app",
      "supportsTablet": true
    },
    "android": {
      "package": "pl.mojaojczyzna.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "estaloca-studio"
  }
}
